{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "**/*.json",
        "outDir": "dist"
      },
      {
        "include": "../keys/**/*",
        "outDir": "dist/keys"
      },
      {
        "include": "../jwt_rsa_key/**/*",
        "outDir": "dist/jwt_rsa_key"
      }
    ]
  }
}
