{
  "name": "@ux-plus/nestjs",
  "version": "1.1.6",
  "description": "根据RESTful API软件设计风格并基于NestJS框架开发的一款后端开发模板集成了数据库(Mysql，Mongodb)、缓存(Redis)、非对称算法RSA，实现了基本的身份验证守卫以及CPU过载保护。它帮你集成了大部分基础功能让你可以专注于主要的业务开发",
  "author": "ux_rcl",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepare": "node scripts/git/setup-git-hooks.js",
    "start": "nest start",
    "start:dev": "pnpm gmodelinter && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "genkey": "npx ts-node scripts/generateKeyPair.ts",
    "gmodelinter": "npx ts-node scripts/generateModelInterface.ts",
    "test": "jest",
    "commit": "node scripts/git/pnpm-commit.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "ts-node test/setup-e2e.ts && jest --config ./test/jest-e2e.json",
    "start:prod": "pm2 start ./ecosystem.config.js",
    "mysql:g": "npx ts-node scripts/database/mysql/generate.ts",
    "mongo:g": "npx ts-node scripts/database/mongodb/generate.ts",
    "mysql:init": "npx ts-node scripts/database/mysql/execute.ts",
    "mongo:init": "npx ts-node scripts/database/mongodb/execute.ts",
    "mysql:c:latest": "pnpm mysql:g && pnpm mysql:i --type=latest",
    "mongo:c:latest": "pnpm mongo:g && pnpm mongo:i --type=latest"
  },
  "dependencies": {
    "@jest/types": "^29.6.3",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.1.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/sequelize": "^11.0.0",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/typeorm": "^11.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/ms": "^2.1.0",
    "@types/ua-parser-js": "^0.7.39",
    "alipay-sdk": "^4.14.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "0.14",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.6.1",
    "lodash-es": "^4.17.23",
    "mongoose": "^8.14.2",
    "ms": "^2.1.3",
    "mysql2": "^3.14.1",
    "nestjs-pino": "^4.5.0",
    "ngrok": "5.0.0-beta.2",
    "nodemailer": "^7.0.2",
    "pidusage": "^4.0.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "typeorm": "^0.3.22",
    "ua-parser-js": "^2.0.8",
    "uuid": "^11.1.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/cookie-parser": "^1.4.8",
    "@types/cron": "^2.4.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/pidusage": "^2.0.5",
    "@types/sequelize": "^4.28.20",
    "@types/supertest": "^7.2.0",
    "commitizen": "^4.3.1",
    "cron": "^4.4.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "inquirer": "^12.6.0",
    "jest": "^29.7.0",
    "jest-html-reporters": "^3.1.7",
    "jest-junit": "^16.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "swagger-ui-express": "^5.0.1",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "reports",
          "outputName": "report.xml"
        }
      ],
      [
        "jest-html-reporters",
        {
          "publicPath": "./reports/html",
          "filename": "unit-report.html",
          "openReport": false
        }
      ]
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "globalTeardown": "<rootDir>/jest.teardown.ts"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
